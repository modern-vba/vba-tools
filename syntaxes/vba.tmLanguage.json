{
  "name": "VBA",
  "scopeName": "source.vba",
  "patterns": [
    {
      "include": "#file-preamble"
    },
    {
      "include": "#body"
    }
  ],
  "repository": {
    "file-preamble": {
      "begin": "(?i)\\A(?=[\\t\\u0019 \\u1680\\u180E\\u2000-\\u200A\\u202F\\u205F\\u3000]*(?:'[^\\r\\n]*)?$|[\\t\\u0019 \\u1680\\u180E\\u2000-\\u200A\\u202F\\u205F\\u3000]*VERSION[\\t\\u0019 \\u1680\\u180E\\u2000-\\u200A\\u202F\\u205F\\u3000]+1\\.0[\\t\\u0019 \\u1680\\u180E\\u2000-\\u200A\\u202F\\u205F\\u3000]+CLASS[\\t\\u0019 \\u1680\\u180E\\u2000-\\u200A\\u202F\\u205F\\u3000]*(?:'[^\\r\\n]*)?$)",
      "end": "^(?![\\t\\u0019 \\u1680\\u180E\\u2000-\\u200A\\u202F\\u205F\\u3000]*(?:'[^\\r\\n]*)?$)",
      "applyEndPatternLast": true,
      "patterns": [
        {
          "include": "#class-header"
        },
        {
          "include": "#documentation-comment"
        },
        {
          "include": "#comment"
        }
      ],
      "comment": "Allow leading trivia once, then leave permanently at the first ordinary source line. The guarded begin avoids a zero-width reopen loop in headerless modules."
    },
    "class-header": {
      "begin": "(?i)^[\\t\\u0019 \\u1680\\u180E\\u2000-\\u200A\\u202F\\u205F\\u3000]*VERSION[\\t\\u0019 \\u1680\\u180E\\u2000-\\u200A\\u202F\\u205F\\u3000]+1\\.0[\\t\\u0019 \\u1680\\u180E\\u2000-\\u200A\\u202F\\u205F\\u3000]+CLASS[\\t\\u0019 \\u1680\\u180E\\u2000-\\u200A\\u202F\\u205F\\u3000]*(?:'[^\\r\\n]*)?$",
      "beginCaptures": {
        "0": {
          "name": "meta.class-header.vba"
        }
      },
      "end": "(?!)",
      "patterns": [
        {
          "begin": "(?i)(?:^[\\t\\u0019 \\u1680\\u180E\\u2000-\\u200A\\u202F\\u205F\\u3000]*END[\\t\\u0019 \\u1680\\u180E\\u2000-\\u200A\\u202F\\u205F\\u3000]*(?:'[^\\r\\n]*)?$|^(?![\\t\\u0019 \\u1680\\u180E\\u2000-\\u200A\\u202F\\u205F\\u3000]*(?:(?:BEGIN|(?![\\t\\u0019 \\u1680\\u180E\\u2000-\\u200A\\u202F\\u205F\\u3000])[A-Za-z_\\u0080-\\uFFFF](?:(?![\\t\\u0019 \\u1680\\u180E\\u2000-\\u200A\\u202F\\u205F\\u3000])[A-Za-z0-9_\\u0080-\\uFFFF])*[\\t\\u0019 \\u1680\\u180E\\u2000-\\u200A\\u202F\\u205F\\u3000]*=[\\t\\u0019 \\u1680\\u180E\\u2000-\\u200A\\u202F\\u205F\\u3000]*(?:(?:[+-]?[\\t\\u0019 \\u1680\\u180E\\u2000-\\u200A\\u202F\\u205F\\u3000]*(?:&H[0-9A-F]+|&O[0-7]+|\\d+(?:\\.\\d*)?(?:E[+-]?\\d+)?|\\.\\d+(?:E[+-]?\\d+)?)|\"(?:[^\"\\r\\n]|\"\")*\"?|True|False))?)[\\t\\u0019 \\u1680\\u180E\\u2000-\\u200A\\u202F\\u205F\\u3000]*)?(?:'[^\\r\\n]*)?$))",
          "beginCaptures": {
            "0": {
              "name": "meta.class-header.vba"
            }
          },
          "end": "(?!)",
          "patterns": [
            {
              "include": "#body"
            }
          ],
          "comment": "Consume END as metadata, or recover without consuming the first ordinary line. Stay in the body through EOF so header-like text cannot reopen the metadata state."
        },
        {
          "name": "meta.class-header.vba",
          "match": "^.+$",
          "comment": "The preceding boundary rule admits only metadata here. Consume nonempty physical lines; leave empty lines unmatched to avoid a zero-width token popping the class state."
        }
      ],
      "comment": "One-shot class export state. Scope metadata lines individually, including an unfinished quoted property through physical EOL. Neither this container nor its permanent body state adds a scope to VBA code."
    },
    "documentation-comment": {
      "name": "comment.block.documentation.vba",
      "match": "^[\\t\\u0019 \\u1680\\u180E\\u2000-\\u200A\\u202F\\u205F\\u3000]*'\\*.*$"
    },
    "comment": {
      "name": "comment.line.apostrophe.vba",
      "match": "'[^\\r\\n]*$"
    },
    "string": {
      "name": "string.quoted.double.vba",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.vba",
          "match": "\"\""
        }
      ]
    },
    "attribute": {
      "name": "meta.attribute.vba",
      "match": "(?i)^[\\t\\u0019 \\u1680\\u180E\\u2000-\\u200A\\u202F\\u205F\\u3000]*Attribute[\\t\\u0019 \\u1680\\u180E\\u2000-\\u200A\\u202F\\u205F\\u3000]+VB_Name(?![A-Za-z0-9_\\u0080-\\uFFFF])"
    },
    "intrinsic-type": {
      "name": "storage.type.intrinsic.vba",
      "match": "(?i)(?<![A-Za-z0-9_\\u0080-\\uFFFF])(?:String|Long|Integer|Boolean|Variant|Object|Date|Double|Single|Currency|Byte|Decimal|LongLong|LongPtr|PtrSafe)(?![A-Za-z0-9_\\u0080-\\uFFFF])"
    },
    "language-constant": {
      "name": "constant.language.vba",
      "match": "(?i)(?<![A-Za-z0-9_\\u0080-\\uFFFF])(?:True|False|Nothing|Null|Empty)(?![A-Za-z0-9_\\u0080-\\uFFFF])"
    },
    "declaration-end-keyword": {
      "name": "keyword.vba",
      "match": "(?i)(?<![A-Za-z0-9_\\u0080-\\uFFFF])End[\\t\\u0019 \\u1680\\u180E\\u2000-\\u200A\\u202F\\u205F\\u3000]+(?:Sub|Function|Property)(?![A-Za-z0-9_\\u0080-\\uFFFF])"
    },
    "control-keyword": {
      "name": "keyword.control.vba",
      "match": "(?i)(?<![A-Za-z0-9_\\u0080-\\uFFFF])(?:End(?![\\t\\u0019 \\u1680\\u180E\\u2000-\\u200A\\u202F\\u205F\\u3000]+(?:Sub|Function|Property)(?![A-Za-z0-9_\\u0080-\\uFFFF]))|If|Then|Else|ElseIf|For|Each|In|Next|Do|Loop|While|Wend|Select|Case|With|Exit)(?![A-Za-z0-9_\\u0080-\\uFFFF])"
    },
    "keyword": {
      "name": "keyword.vba",
      "match": "(?i)(?<![A-Za-z0-9_\\u0080-\\uFFFF])(?:Public|Private|Friend|Global|Dim|Static|Const|Sub|Function|Property|Get|Let|Set|Enum|Type|Event|RaiseEvent|Implements|Option|Explicit|Base|Module|As|ByVal|ByRef|Optional|ParamArray|Call|New|Declare|PtrSafe|Lib|Alias|WithEvents)(?![A-Za-z0-9_\\u0080-\\uFFFF])"
    },
    "number": {
      "name": "constant.numeric.vba",
      "match": "(?:&H[0-9A-Fa-f]+|\\b\\d+(?:\\.\\d+)?\\b)"
    },
    "operator": {
      "name": "keyword.operator.vba",
      "match": "[-+*/=<>:&]"
    },
    "body": {
      "patterns": [
        {
          "include": "#documentation-comment"
        },
        {
          "include": "#comment"
        },
        {
          "include": "#string"
        },
        {
          "include": "#attribute"
        },
        {
          "include": "#intrinsic-type"
        },
        {
          "include": "#language-constant"
        },
        {
          "include": "#declaration-end-keyword"
        },
        {
          "include": "#control-keyword"
        },
        {
          "include": "#keyword"
        },
        {
          "include": "#number"
        },
        {
          "include": "#operator"
        }
      ]
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://modern-vba.github.io/vba-tools/schemas/project-manifest.schema.json",
  "title": "VBA Tools Project Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "projectName",
    "primaryDocument",
    "documents"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "projectName": {
      "type": "string",
      "minLength": 1
    },
    "primaryDocument": {
      "type": "string",
      "minLength": 1
    },
    "documents": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "minLength": 1
      },
      "patternProperties": {
        "^.+$": {
          "$ref": "#/definitions/document"
        }
      },
      "additionalProperties": false
    },
    "commonModulesRepository": {
      "type": "string",
      "minLength": 1
    },
    "commandDefaults": {
      "$ref": "#/definitions/commandDefaults"
    }
  },
  "definitions": {
    "document": {
      "type": "object",
      "required": [
        "kind",
        "sourcePath",
        "templatePath",
        "binPath",
        "publishPath",
        "commonModules",
        "references"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "excel"
        },
        "sourcePath": {
          "type": "string",
          "minLength": 1
        },
        "templatePath": {
          "type": "string",
          "minLength": 1
        },
        "binPath": {
          "type": "string",
          "minLength": 1
        },
        "publishPath": {
          "type": "string",
          "minLength": 1
        },
        "commonModules": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/commonModule"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/reference"
          }
        }
      }
    },
    "commonModule": {
      "type": "object",
      "required": [
        "name",
        "moduleFile",
        "requested",
        "testOnly"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "moduleFile": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\]+\\.([bB][aA][sS]|[cC][lL][sS]|[fF][rR][mM])$"
        },
        "requested": {
          "type": "boolean"
        },
        "testOnly": {
          "type": "boolean"
        }
      }
    },
    "reference": {
      "type": "object",
      "required": [
        "name",
        "requested"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$",
          "not": {
            "pattern": "^[Vv][Ii][Ss][Uu][Aa][Ll] [Bb][Aa][Ss][Ii][Cc] [Ff][Oo][Rr] [Aa][Pp][Pp][Ll][Ii][Cc][Aa][Tt][Ii][Oo][Nn][Ss]$"
          }
        },
        "requested": {
          "type": "boolean"
        }
      }
    },
    "commandDefaults": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "test": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "format": {
              "enum": [
                "text",
                "ndjson"
              ]
            },
            "executionTimeoutSeconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "excelAutomation": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "workbookOpenTimeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "workbookSaveTimeoutSeconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  }
}

{
  "manifestVersion": 1,
  "runtimes": {
    "vbaDev": {
      "label": "vba-dev",
      "executablePath": "bin/vba-dev/win-x64/vba-dev.exe",
      "projectPath": "tools/vba-dev/src/VbaDev.Cli/VbaDev.Cli.csproj",
      "assemblyName": "vba-dev",
      "runtimeIdentifier": "win-x64",
      "selfContained": true,
      "publishSingleFile": true,
      "smokeCommand": [
        "capabilities",
        "--format",
        "json"
      ],
      "contractPath": "vba-dev-contract.json"
    },
    "vbaDebugAdapter": {
      "label": "vba-debug-adapter",
      "executablePath": "bin/vba-debug-adapter/win-x64/vba-debug-adapter.exe",
      "projectPath": "tools/vba-debug-adapter/src/VbaDebugAdapter.Cli/VbaDebugAdapter.Cli.csproj",
      "assemblyName": "vba-debug-adapter",
      "runtimeIdentifier": "win-x64",
      "selfContained": true,
      "publishSingleFile": true,
      "smokeCommand": [
        "capabilities",
        "--format",
        "json"
      ],
      "contractPath": "vba-debug-adapter-contract.json"
    },
    "vbaLanguageServer": {
      "label": "VbaLanguageServer",
      "executablePath": "bin/vba-language-server/win-x64/vba-language-server.exe",
      "projectPath": "tools/vba-language-server/src/VbaLanguageServer.Cli/VbaLanguageServer.Cli.csproj",
      "assemblyName": "vba-language-server",
      "runtimeIdentifier": "win-x64",
      "selfContained": true,
      "publishSingleFile": true,
      "smokeCommand": [
        "--version"
      ],
      "versionOutputPrefix": "vba-language-server "
